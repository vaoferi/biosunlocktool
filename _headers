# Правила кешування для Cloudflare Pages (custom domains включно).
# Історія: 2026-09-09 браузери години отримували СТАРІ main.css/background.js з edge-кешу
# (cache-control immutable без хешу в імені файлу) — виглядало як «фон зник, hero не того
# розміру», хоча деплой був зелений. Тому: звичайні ассети ПОВИННІ ревалідуватись (etag);
# довгий кеш дозволений ТІЛЬКИ для vendor-бібліотек, версія яких зашита в шлях.
# Другий шар захисту: ?v=<штамп> на URL ассетів в index.html і background.js
# (див. коментар біля stylesheet-лінка в index.html).
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# OG-банер: скрейпери (Telegram/FB) кешують og:image дуже агресивно — короткий TTL,
# щоб регенерація банера дійшла до превʼю без багатогодинного застарілого edge-кешу.
# ВЕРИФІКОВАНО 2026-09-09: на pages.dev правило діє (3600). На КОСТОМНОМУ домені
# зона Cloudflare з Browser Cache TTL (дефолт 4 год) перезаписує короткі max-age на
# 14400 (vendor вцілів завдяки immutable, HTML — бо max-age=0). Не «лагодити» додаванням
# immutable сюди — це пастка інциденту 2026-09-09. Єдиний фікс: дашборд → Caching →
# Browser Cache TTL → Respect Existing Headers (потрібен доступ до зони).
/og-cover.jpg
  Cache-Control: public, max-age=3600, must-revalidate

/locales/en-US/*
  Cache-Control: public, max-age=0, must-revalidate
